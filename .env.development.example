# Local development only. scripts/init-development-local.sh copies this to
# .env.development and replaces every "generated" value with a random secret.
COMPOSE_PROJECT_NAME=patito-dev
TZ=America/La_Paz

MARIADB_ROOT_PASSWORD=generated
MARIADB_DATABASE=jol
MARIADB_USER=jol
MARIADB_PASSWORD=generated
MARIADB_PORT=3307

PATITO_WEB_PORT=8082
ADMIN_API_PORT=8088
ADMIN_UI_PORT=8083
VIBE_IDE_PORT=3000
VIBE_LSP_PORT=3001
PHPMYADMIN_PORT=8081

PATITO_WEB_PUBLIC_URL=http://localhost:8082
ADMIN_API_PUBLIC_URL=http://localhost:8088/api
ADMIN_API_PUBLIC_WS_URL=ws://localhost:8088/api
ADMIN_UI_PUBLIC_URL=http://localhost:8083/admin/
VIBE_IDE_PUBLIC_URL=http://localhost:3000/ide/
VIBE_IDE_CONTEXT_URL=http://localhost:8088/api/patito-ide/context
PHPMYADMIN_PUBLIC_URL=http://localhost:8081/

# Sessions shared by web and API
JWT_ISS=patito
JWT_AUD=patito
JWT_SECRET=generated

# IDE launch tokens: web signs, API and IDE validate
VIBE_IDE_TOKEN_SECRET=generated
VIBE_IDE_TOKEN_ISS=patito-online-judge
VIBE_IDE_TOKEN_AUD=vibe-ide

# Lab machines control-server
CONTROL_TOKEN_SECRET=generated
CONTROL_LOBBY_ENROLL_TOKEN=generated
CONTROL_PORT=8090

# Shared only by patito-ide and patito-lsp-server
LSP_AUTH_TOKEN=generated
